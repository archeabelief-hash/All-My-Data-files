{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral AR Event",
  "type": "object",
  "required": ["id", "timestamp_ms", "layer", "kind", "confidence"],
  "properties": {
    "id": {"type": "string"},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "layer": {"enum": ["observation", "inference", "evidence", "presentation"]},
    "kind": {"type": "string"},
    "channel": {"enum": ["visual", "vocal", "language", "motion", "context", "fusion"]},
    "value": {},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "quality": {"type": "number", "minimum": 0, "maximum": 1},
    "supports": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}
